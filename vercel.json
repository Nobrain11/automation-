{
  "functions": {
    "api/health.ts": { "maxDuration": 10 },
    "api/terminal/auth.ts": { "maxDuration": 10 },
    "api/telegram/webhook.ts": { "maxDuration": 30 },
    "api/telegram/setup.ts": { "maxDuration": 30 },
    "api/terminal/[...path].ts": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/auth/telegram", "destination": "/api/terminal/auth" },
    { "source": "/auth/callback", "destination": "/api/terminal/auth" },
    { "source": "/terminal", "destination": "/terminal/index.html" },
    { "source": "/", "destination": "/terminal/index.html" }
  ]
}
