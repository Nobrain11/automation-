{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm exec tsc --noEmit || true",
  "outputDirectory": "public",
  "functions": {
    "api/health.ts": { "maxDuration": 10, "memory": 512 },
    "api/terminal/auth.ts": { "maxDuration": 10, "memory": 512 },
    "api/telegram/webhook.ts": { "maxDuration": 30, "memory": 1024 },
    "api/telegram/setup.ts": { "maxDuration": 30, "memory": 512 },
    "api/terminal/[...path].ts": { "maxDuration": 30, "memory": 1024 }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/auth/telegram", "destination": "/api/terminal/auth" },
    { "source": "/auth/callback", "destination": "/api/terminal/auth" },
    { "source": "/terminal", "destination": "/terminal/index.html" },
    { "source": "/", "destination": "/terminal/index.html" }
  ]
}
