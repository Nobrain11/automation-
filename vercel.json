{
  "functions": {
    "api/telegram/webhook.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/health", "dest": "/api/health" },
    { "src": "/auth/telegram", "dest": "/api/terminal/auth" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/terminal", "dest": "/terminal/index.html" },
    { "src": "/terminal/(.*)", "dest": "/terminal/$1" },
    { "src": "/", "dest": "/terminal/index.html" },
    { "src": "/(.*)", "dest": "/terminal/$1" }
  ]
}
