# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random secret used by Telegram when calling the webhook
TELEGRAM_WEBHOOK_SECRET=
# Separate random token for the one-time setup endpoint
TELEGRAM_WEBHOOK_SETUP_TOKEN=


SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# MUST stay the same across deploys or encrypted wallets cannot be decrypted
WALLET_ENCRYPTION_KEY=

# Railway: mount a volume at /data and keep this path
DATABASE_PATH=/data/bot.sqlite

LOG_LEVEL=info

PORT=3000
WEB_BASE_URL=https://your-app.up.railway.app

ADMIN_TELEGRAM_ID=
