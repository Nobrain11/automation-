# === Required ===
TELEGRAM_BOT_TOKEN=
# alias also accepted:
# BOT_TOKEN=

# 32-byte key as base64 — generate once and NEVER change after wallets exist:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WALLET_ENCRYPTION_KEY=

# Public URL of THIS always-on server (no trailing slash)
WEB_BASE_URL=https://your-domain.example
APP_URL=https://your-domain.example

# === Strongly recommended ===
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Persistent SQLite path (Docker/Railway volume mount)
DATABASE_PATH=/data/bot.sqlite

PORT=3000
LOG_LEVEL=info

# Optional admins (comma-separated Telegram user ids)
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=

# Only needed if you use Vercel webhook mode (not recommended for the bot process)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SETUP_TOKEN=
